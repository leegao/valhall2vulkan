    {
      "name": "fetch_raw_src_u32",
      "kind": "inline_ops",
      "ret": "SsaId",
      "params": [
        {
          "type": "SsaBuilder&",
          "name": "sb"
        },
        {
          "type": "uint32_t",
          "name": "blk_id"
        },
        {
          "type": "const DecodedValhallInst&",
          "name": "ins"
        },
        {
          "type": "size_t",
          "name": "src_idx"
        }
      ],
      "inline_ops": [
        "if (@src_oob(%src_idx)) { return @const_u32(0); }",
        "if (@src_is_reg(%src_idx)) { return @src_read_reg(%src_idx); }",
        "if (@src_is_fau_uniform(%src_idx)) { return @emit_load_fau_u32(@src_reg_num(%src_idx)); }",
        "if (@src_is_small_const(%src_idx)) { return @src_emit_imm_u32(%src_idx); }",
        "if (@src_is_fau_pc(%src_idx)) {",
        "  %pc_base : u64 = @emit_load_sideband_u64(1);",
        "  %pc_off : u64 = @ins_pc_u64();",
        "  %cur_pc : u64 = IAdd64(%pc_base, %pc_off);",
        "  if (@src_word_select(%src_idx)) { return @split64_hi(%cur_pc); }",
        "  return @split64_lo(%cur_pc);",
        "}",
        "if (@src_is_fau_lane_id(%src_idx)) { return @emit_lane_id(); }",
        "if (@src_is_fau_lane_width(%src_idx)) { return @emit_lane_width(); }",
        "return @emit_load_fau_u32(@src_reg_num(%src_idx));"
      ]
    },
    {
      "name": "fetch_src_int32",
      "kind": "inline_ops",
      "ret": "SsaId",
      "params": [
        {
          "type": "SsaBuilder&",
          "name": "sb"
        },
        {
          "type": "uint32_t",
          "name": "blk_id"
        },
        {
          "type": "const DecodedValhallInst&",
          "name": "ins"
        },
        {
          "type": "size_t",
          "name": "src_idx"
        },
        {
          "type": "bool",
          "name": "is_signed"
        }
      ],
      "inline_ops": [
        "%val : u32 = @fetch_raw_src_u32(%src_idx);",
        "if (@src_swz_eq(%src_idx, \"b0\")) { %val = @extract_bits(%val, 0, 8, %is_signed); }",
        "else if (@src_swz_eq(%src_idx, \"b1\")) { %val = @extract_bits(%val, 8, 8, %is_signed); }",
        "else if (@src_swz_eq(%src_idx, \"b2\")) { %val = @extract_bits(%val, 16, 8, %is_signed); }",
        "else if (@src_swz_eq(%src_idx, \"b3\")) { %val = @extract_bits(%val, 24, 8, %is_signed); }",
        "else if (@src_swz_eq(%src_idx, \"h0\")) { %val = @extract_bits(%val, 0, 16, %is_signed); }",
        "else if (@src_swz_eq(%src_idx, \"h1\")) { %val = @extract_bits(%val, 16, 16, %is_signed); }",
        "else if (@src_swz_eq(%src_idx, \"h00\")) {",
        "  %h : u32 = @extract_bits(%val, 0, 16, %is_signed);",
        "  %hi : u32 = Shl(%h, @const_u32(16));",
        "  %val = BitOr(%h, %hi);",
        "} else if (@src_swz_eq(%src_idx, \"h11\")) {",
        "  %h : u32 = @extract_bits(%val, 16, 16, %is_signed);",
        "  %hi : u32 = Shl(%h, @const_u32(16));",
        "  %val = BitOr(%h, %hi);",
        "} else if (@src_swz_is_b_rep(%src_idx)) {",
        "  %boff : uint32_t = @src_swz_b_rep_off(%src_idx);",
        "  %bk : u32 = BfeU(%val, @const_u32(%boff), @const_u32(8));",
        "  %val = IMul(%bk, @const_u32(0x01010101u));",
        "}",
        "if (@get_src_abs(%src_idx)) {",
        "  %sval : s32 = @bitcast(s32, %val);",
        "  %ab : s32 = SAbs(%sval);",
        "  %val = @bitcast(u32, %ab);",
        "}",
        "if (@get_src_neg(%src_idx)) {",
        "  %sval2 : s32 = @bitcast(s32, %val);",
        "  %ng : s32 = SNeg(%sval2);",
        "  %val = @bitcast(u32, %ng);",
        "}",
        "if (@get_src_not(%src_idx)) {",
        "  %val = BitNot(%val);",
        "}",
        "return %val;"
      ]
    },
    {
      "name": "fetch_src_f32",
      "kind": "inline_ops",
      "ret": "SsaId",
      "params": [
        {
          "type": "SsaBuilder&",
          "name": "sb"
        },
        {
          "type": "uint32_t",
          "name": "blk_id"
        },
        {
          "type": "const DecodedValhallInst&",
          "name": "ins"
        },
        {
          "type": "size_t",
          "name": "src_idx"
        }
      ],
      "inline_ops": [
        "%raw_u32 : u32 = @fetch_raw_src_u32(%src_idx);",
        "%fval : f32 = @bitcast(f32, %raw_u32);",
        "if (@src_swz_eq(%src_idx, \"h0\")) {",
        "  %vec : v2f32 = UnpackHalf2x16(%raw_u32);",
        "  %fval = @extract(f32, %vec, 0);",
        "} else if (@src_swz_eq(%src_idx, \"h1\")) {",
        "  %vec : v2f32 = UnpackHalf2x16(%raw_u32);",
        "  %fval = @extract(f32, %vec, 1);",
        "}",
        "if (@get_src_abs(%src_idx)) { %fval = FAbs(%fval); }",
        "if (@get_src_neg(%src_idx)) { %fval = FNeg(%fval); }",
        "return %fval;"
      ]
    },
    {
      "name": "fetch_src_v2f16",
      "kind": "inline_ops",
      "ret": "SsaId",
      "params": [
        {
          "type": "SsaBuilder&",
          "name": "sb"

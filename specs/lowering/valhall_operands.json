    "extract_bits": {
      "kind": "inline_ops",
      "ret": "SsaId",
      "args": [
        {
          "type": "SsaId",
          "name": "val"
        },
        {
          "type": "uint32_t",
          "name": "offset"
        },
        {
          "type": "uint32_t",
          "name": "count"
        },
        {
          "type": "bool",
          "name": "is_signed"
        }
      ],
      "inline_ops": [
        "if (%is_signed) {",
        "  %sval : s32 = @bitcast(s32, %val);",
        "  %ext : s32 = BfeS(%sval, @const_u32(%offset), @const_u32(%count));",
        "  return @bitcast(u32, %ext);",
        "}",
        "return BfeU(%val, @const_u32(%offset), @const_u32(%count));"
      ]
    },
    "widen_to_u64": {
      "kind": "inline_ops",
      "ret": "SsaId",
      "args": [
        {
          "type": "SsaId",
          "name": "w32"
        },
        {
          "type": "bool",
          "name": "sext"
        }
      ],
      "effects": [
        "cap:Int64"
      ],
      "inline_ops": [
        "if (%sext) {",
        "  %s32 : s32 = @bitcast(s32, %w32);",
        "  %cvt : s64 = SConvert32To64(%s32);",
        "  return @bitcast(u64, %cvt);",
        "}",
        "return UConvert32To64(%w32);"
      ]
    },
    "apply_v2_swizzle": {
      "kind": "inline_ops",
      "ret": "SsaId",
      "args": [
        {
          "type": "SsaId",
          "name": "vec"
        },
        {
          "type": "ValType",
          "name": "vt"
        },
        {
          "type": "uint32_t",
          "name": "src_idx"
        }
      ],
      "inline_ops": [
        "if (@src_swz_eq(%src_idx, \"h00\") || @src_swz_eq(%src_idx, \"h0\")) {",
        "  return @shuffle2(%vt, %vec, %vec, 0, 0);",
        "} else if (@src_swz_eq(%src_idx, \"h11\") || @src_swz_eq(%src_idx, \"h1\")) {",
        "  return @shuffle2(%vt, %vec, %vec, 1, 1);",
        "} else if (@src_swz_eq(%src_idx, \"h10\")) {",
        "  return @shuffle2(%vt, %vec, %vec, 1, 0);",
        "}",
        "return %vec;"
      ]
    },
    "apply_f32_clamp": {
      "kind": "inline_ops",
      "ret": "SsaId",
      "args": [
        {
          "type": "SsaId",
          "name": "val_f32"
        }
      ],
      "effects": [
        "uses_glsl_std450"
      ],
      "inline_ops": [
        "if (@has_clamp_0_1()) {",
        "  return FClamp(%val_f32, @const_f32_bits(0), @const_f32_bits(0x3f800000u));",
        "} else if (@has_clamp_m1_1()) {",
        "  return FClamp(%val_f32, @const_f32_bits(0xbf800000u), @const_f32_bits(0x3f800000u));",
        "} else if (@has_clamp_0_inf()) {",
        "  return FMax(%val_f32, @const_f32_bits(0));",
        "}",
        "return %val_f32;"
      ]
    },
    "apply_v2f16_clamp": {
      "kind": "inline_ops",
      "ret": "SsaId",
      "args": [
        {
          "type": "SsaId",
          "name": "vec2_f32"
        }
      ],
      "effects": [
        "uses_glsl_std450"
      ],
      "inline_ops": [
        "if (@has_clamp_0_1()) {",
        "  %lo : f32 = @const_f32_bits(0);",
        "  %hi : f32 = @const_f32_bits(0x3f800000u);",
        "  %vlo : v2f32 = VecConstruct2(%lo, %lo);",
        "  %vhi : v2f32 = VecConstruct2(%hi, %hi);",
        "  return FClamp(%vec2_f32, %vlo, %vhi);",
        "} else if (@has_clamp_m1_1()) {",
        "  %lo : f32 = @const_f32_bits(0xbf800000u);",
        "  %hi : f32 = @const_f32_bits(0x3f800000u);",
        "  %vlo : v2f32 = VecConstruct2(%lo, %lo);",
        "  %vhi : v2f32 = VecConstruct2(%hi, %hi);",
        "  return FClamp(%vec2_f32, %vlo, %vhi);",
        "} else if (@has_clamp_0_inf()) {",
        "  %z : f32 = @const_f32_bits(0);",
        "  %vz : v2f32 = VecConstruct2(%z, %z);",
        "  return FMax(%vec2_f32, %vz);",
        "}",
        "return %vec2_f32;"
      ]
    },
    "extract_lane_u32": {
      "kind": "inline_ops",
